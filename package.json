{
  "name": "gymlog-1.0",
  "version": "1.0.0",
  "description": "> **Track every lift. Beat every session.**",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:db && npm run test:ui",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:db": "node --test tests/database.test.js",
    "test:ui": "vitest run",
    "test:native": "GYMLOG_NATIVE_TEST=1 node --test tests/database.test.js tests/concurrency.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "test:required": "npm test && npm run test:native && npm run test:browser && npm run build",
    "test:live": "node --test --test-concurrency=1 tests/live.test.js tests/live-browser.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DhruboImtiaz/GymLog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DhruboImtiaz/GymLog/issues"
  },
  "homepage": "https://github.com/DhruboImtiaz/GymLog#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "chart.js": "^4.5.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "17.6.0-beta.15",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "react-test-renderer": "19.3.0",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
}
